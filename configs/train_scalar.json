{
  "train_data": "runs/labels/train.jsonl",
  "dev_data": "runs/labels/dev.jsonl",
  "output_dir": "runs/checkpoints/scalar_s100",
  "kind": "scalar",
  "backend": "hf",
  "base_model": "Qwen/Qwen3-4B",
  "device": "cuda",
  "quantized": true,
  "max_length": 4096,
  "epochs": 3,
  "batch_size": 1,
  "gradient_accumulation": 16,
  "lr": 0.0001,
  "head_lr": 0.001,
  "scheduler": "cosine",
  "warmup_ratio": 0.03,
  "weight_decay": 0.01,
  "patience": 2,
  "seed": 100,
  "lora_rank": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "gradient_checkpointing": true,
  "harm_weight": 2.0,
  "cost_weight": 0.05,
  "require_complete_labels": true
}
